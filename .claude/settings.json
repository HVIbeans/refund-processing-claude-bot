{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm start:*)",
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "mcp__refund-tools__get_customer",
      "mcp__refund-tools__get_order",
      "mcp__refund-tools__get_payment",
      "mcp__refund-tools__list_escalations",
      "mcp__refund-tools__list_tool_calls",
      "mcp__refund-tools__list_decisions"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/prompt-coach.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-policy.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-tests.js",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
