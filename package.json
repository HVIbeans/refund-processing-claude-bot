{
  "name": "refund-processing-claude-bot",
  "version": "0.1.0",
  "description": "Learning project: a payment refund processing agent built with the Claude API",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --test",
    "db:reset": "node src/db/reset.js",
    "mcp": "node src/mcp/stdio.js",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node src/mcp/stdio.js",
    "chat": "node --env-file-if-exists=.env src/agent/repl.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  }
}
