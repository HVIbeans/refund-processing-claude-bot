# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Optional: a proxy or gateway in front of the Claude API (the SDK reads this itself).
ANTHROPIC_BASE_URL=

# Optional: defaults to claude-sonnet-4-6. Must be a model the gateway serves.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Optional: thinking effort, low | medium | high (default medium). /effort changes it in the chat.
ANTHROPIC_EFFORT="medium"

# Optional: which agent loop the terminal chat (npm run chat) uses. Default: manual.
# The web chat (npm start) always uses manual.
# Read once at startup; restart the chat to switch.
#   manual - hand-written tool loop (src/agent/chat.js): runs tools one at a time, recovers from failed turns
#   runner - the Anthropic SDK's beta Tool Runner: less code, runs a round's tools in parallel, no recovery
#   sdk    - the Claude Agent SDK: a separate Claude Code process per conversation, slower to start
#   multi  - an orchestrator with triage, fraud-check and refund specialist agents: about 2.7x the cost, 3.7x slower
ANTHROPIC_LOOP="manual"